# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (NEVER expose these client-side) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DECK_BUCKET=pitch-decks

# --- Payment ---
# "hosted_form": redirect to a no-code payment page (Cashfree Payment Form,
#   etc.). Manual confirmation by an admin. Only PAYMENT_FORM_URL is needed.
# Switch to a real gateway id (e.g. "cashfree") once you have API keys and
# implement its provider — then PAYMENT_SECRET_KEY / PAYMENT_WEBHOOK_SECRET
# become required.
PAYMENT_PROVIDER=hosted_form
PAYMENT_FORM_URL=https://payments.cashfree.com/forms?code=Skip

# Only needed for a full-API provider (not hosted_form):
# PAYMENT_SECRET_KEY=your-gateway-secret-key
# PAYMENT_WEBHOOK_SECRET=your-gateway-webhook-signing-secret

PRIORITY_PRICE_AMOUNT=25000
PRIORITY_PRICE_CURRENCY=INR
