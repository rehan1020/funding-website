# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (NEVER expose these client-side) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DECK_BUCKET=pitch-decks

# --- Payment gateway (server-only). Provider TBD; adapter reads these. ---
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=your-gateway-secret-key
PAYMENT_WEBHOOK_SECRET=your-gateway-webhook-signing-secret
PRIORITY_PRICE_AMOUNT=25000
PRIORITY_PRICE_CURRENCY=INR
