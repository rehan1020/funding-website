# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (NEVER expose these client-side) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DECK_BUCKET=pitch-decks

# --- Payment ---
# "cashfree": full Cashfree PG API. Orders are created server-side and the
#   browser opens Cashfree's hosted checkout via the JS SDK. Payment is
#   confirmed automatically (signed webhook + Get Order status check) — no
#   manual admin step. Requires CASHFREE_APP_ID + CASHFREE_SECRET_KEY.
# "hosted_form": legacy no-code redirect to a payment form; manual admin
#   confirmation. Only PAYMENT_FORM_URL is needed.
PAYMENT_PROVIDER=cashfree

# Cashfree PG credentials (from the Cashfree dashboard → Developers → API Keys).
# The Secret Key also verifies webhook signatures — no separate webhook secret.
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
# "production" (live keys) or "sandbox" (test keys). Defaults to production.
CASHFREE_ENV=production

# Only for the legacy "hosted_form" provider:
# PAYMENT_FORM_URL=https://payments.cashfree.com/forms?code=Skip

# Priority review price. PRIORITY_PRICE_AMOUNT is in MAJOR units — i.e. rupees
# for INR (25000 = ₹25,000), matching Cashfree's order_amount unit.
PRIORITY_PRICE_AMOUNT=25000
PRIORITY_PRICE_CURRENCY=INR
